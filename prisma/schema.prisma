generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  journalEntries JournalEntry[]
  OfficerEntry   OfficerEntry[]
}

model JournalEntry {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OfficerEntry {
  id         String   @id @default(uuid())
  title      String
  content    String
  department String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AnalysisReport {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  rawOutput String   @db.Text // Store the full raw JSON response from Claude

  // This creates the one-to-many relationship
  orders ImprovementOrder[]
}

model ImprovementOrder {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  department  String
  severity    String // "low", "medium", "high", "critical"
  description String   @db.Text
  status      String   @default("pending") // e.g., "pending", "in-progress", "completed"

  // Foreign key to link back to the analysis report
  reportId       String
  analysisReport AnalysisReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}
